{
  "name": "@tokenflow/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "tokenflow": "dist/cli.js",
    "tflow": "dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outdir=dist --banner:js='#!/usr/bin/env node' --packages=external",
    "dev": "tsx --watch src/cli.ts",
    "tui": "tsx src/cli.ts -- config"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.0",
    "@tokenflow/shared": "workspace:*",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "ink": "^4.4.1",
    "json5": "^2.2.3",
    "open": "^10.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
