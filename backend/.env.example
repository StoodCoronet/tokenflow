# Token Flow Configuration
DATABASE_URL=sqlite+aiosqlite:///./token_flow.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/token_flow

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Proxy Settings
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# Analysis Settings
ENABLE_ANALYSIS=true
ANALYSIS_QUEUE_SIZE=1000

# Logging
LOG_LEVEL=INFO
