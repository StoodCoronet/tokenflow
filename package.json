{
  "name": "tokenflow",
  "version": "0.1.0",
  "private": true,
  "description": "LLM traffic monitoring and context optimization system",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -n server,ui -c blue,green \"pnpm --filter @tokenflow/server dev\" \"pnpm --filter @tokenflow/ui dev\"",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "better-sqlite3"]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
